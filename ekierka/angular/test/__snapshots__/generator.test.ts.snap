  "ek-switch.ts": 
"// Generated from custom-elements.json by scripts/generate.ts. Do not edit.
import {
  booleanAttribute,
  ChangeDetectionStrategy,
  Component,
  ElementRef,
  inject,
  input,
  model,
  output,
  type OutputEmitterRef,
} from '@angular/core';
import { type FormValueControl, type ValidationError } from '@angular/forms/signals';
import { defineEkSwitch, type EkSwitch as Host, type PickDetail } from '@ekierka/elements';
import { forwardInputs } from '../forward-inputs';

/**
 * A form control: value plus ek-value-change.
 */
@Component({
  selector: 'ek-switch',
  template: '',
  changeDetection: ChangeDetectionStrategy.OnPush,
  host: {
    '(ek-value-change)': 'value.set(element.value); emit(ekValueChange, $event)',
    '(ek-open-change)': 'open.set(element.open); emit(ekOpenChange, $event)',
    '(ek-pick)': 'emit(ekPick, $event)',
    '(ek-partial)': 'emit(ekPartial, $event)',
    '(ek-tagged)': 'emit(ekTagged, $event)',
    '(focusout)': 'touch.emit()',
  },
})
export class EkSwitchComponent implements FormValueControl<Host['value']> {
  protected readonly element = inject<ElementRef<Host>>(ElementRef).nativeElement;

  readonly value = model<Host['value']>('');
  readonly label = input<Host['label'] | undefined>(undefined);
  readonly size = input<Host['size'] | undefined>(2);
  readonly open = model<Host['open'] | undefined>(false);
  readonly disabled = input<boolean, unknown>(false, { transform: booleanAttribute });
  readonly readonly = input<boolean, unknown>(false, { transform: booleanAttribute });
  readonly invalid = input<boolean, unknown>(false, { transform: booleanAttribute });
  readonly required = input<boolean, unknown>(false, { transform: booleanAttribute });
  readonly touched = input<boolean, unknown>(false, { transform: booleanAttribute });
  readonly name = input<string>('');
  readonly errors = input<readonly ValidationError.WithOptionalField[]>([]);
  readonly mode = input<Host['mode'] | undefined>('a');

  /**
   * The value changed.
   */
  readonly ekValueChange = output<CustomEvent<string>>();
  readonly ekOpenChange = output<CustomEvent<boolean>>();
  /**
   * An option was picked.
   */
  readonly ekPick = output<CustomEvent<PickDetail>>();
  readonly ekPartial = output<CustomEvent<Partial<PickDetail>>>();
  readonly ekTagged = output<CustomEvent<'Open' | 'Closed'>>();
  /** Signal forms: the user has interacted with the field. */
  readonly touch = output<void>();

  constructor() {
    defineEkSwitch();
    forwardInputs(this, this.element, [
      'value',
      'label',
      'size',
      'open',
      'disabled',
      'readonly',
      'invalid',
      'required',
      'touched',
      'name',
      'errors',
      'mode',
    ]);
  }

  // Host listeners only know \`Event\`; the output carries the type the element documents.
  protected emit<T extends Event>(target: OutputEmitterRef<T>, event: Event): void {
    target.emit(event as T);
  }
}
