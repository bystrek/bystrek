#!/usr/bin/env bash
set -Eeuo pipefail

STACK_DIR="${BYSTREK_STACK_DIR:-"$HOME/bystrek"}"
CONFIG_DIR="${HOME}/.config/bystrek"
CONFIG_FILE="${CONFIG_DIR}/evaluator.env"
ENV_FILE="${STACK_DIR}/.env"
EVALUATIONS_DIR="${STACK_DIR}/evaluations"
API_WAIT_ATTEMPTS=30
API_WAIT_SECONDS=2

umask 077

usage() {
  echo "usage: $(basename "$0") <ollama-model>" >&2
}

die() {
  echo "$*" >&2
  exit 1
}

file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

file_owner() {
  stat -c '%u' "$1" 2>/dev/null || stat -f '%u' "$1"
}

require_owner_only() {
  local path="$1"
  local mode
  local owner

  [[ ! -L "$path" ]] || die "Refusing symbolic link: $path"
  mode="$(file_mode "$path")"
  owner="$(file_owner "$path")"
  [[ "$owner" == "$EUID" ]] || die "$path must be owned by the invoking user."
  (( (8#$mode & 0077) == 0 )) || die "$path must not be readable or writable by group or others."
}

read_eval_token() {
  local line
  local matches=0
  local token=''

  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      EVAL_AUTH_TOKEN=*)
        ((matches += 1))
        token="${line#EVAL_AUTH_TOKEN=}"
        ;;
    esac
  done < "$CONFIG_FILE"

  (( matches == 1 )) || die "$CONFIG_FILE must contain exactly one EVAL_AUTH_TOKEN entry."
  [[ -n "$token" ]] || die "EVAL_AUTH_TOKEN is empty."
  printf '%s' "$token"
}

compose() {
  (
    cd "$STACK_DIR"
    docker compose "$@"
  )
}

recreate_api() {
  (
    cd "$STACK_DIR"
    API_IMAGE="$api_image" docker compose up -d --force-recreate api
  )
}

write_active_model() {
  local model="$1"
  local temporary_file="${ENV_FILE}.evaluator.$$"

  awk -v model="$model" '
    /^LLM_MODEL=/ {
      print "LLM_MODEL=" model
      found = 1
      next
    }
    { print }
    END {
      if (!found) print "LLM_MODEL=" model
    }
  ' "$ENV_FILE" > "$temporary_file"
  chmod 600 "$temporary_file"
  mv -f "$temporary_file" "$ENV_FILE"
}

restore_active_model() {
  local temporary_file="${ENV_FILE}.evaluator.$$"

  if [[ "$had_original_model" == true ]]; then
    awk -v original="$original_model_line" '
      /^LLM_MODEL=/ {
        if (!restored) {
          print original
          restored = 1
        }
        next
      }
      { print }
      END {
        if (!restored) print original
      }
    ' "$ENV_FILE" > "$temporary_file"
  else
    awk '!/^LLM_MODEL=/' "$ENV_FILE" > "$temporary_file"
  fi
  chmod 600 "$temporary_file"
  mv -f "$temporary_file" "$ENV_FILE"
}

wait_for_api() {
  local attempt

  for ((attempt = 1; attempt <= API_WAIT_ATTEMPTS; attempt += 1)); do
    if compose exec -T api bun -e '
      const response = await fetch("http://127.0.0.1:3000/health");
      process.exit(response.ok ? 0 : 1);
    ' >/dev/null 2>&1; then
      return 0
    fi
    sleep "$API_WAIT_SECONDS"
  done

  return 1
}

model_changed=false
lock_dir=''
result_temporary=''
result_file=''
success_message=''
had_original_model=false
original_model_line=''
api_image=''

cleanup() {
  local status=$?

  trap - EXIT INT TERM HUP

  if [[ "$model_changed" == true ]]; then
    if ! restore_active_model; then
      echo "Failed to restore LLM_MODEL in $ENV_FILE." >&2
      status=1
    elif ! recreate_api; then
      echo "Restored LLM_MODEL but failed to recreate api." >&2
      status=1
    fi
  fi

  if [[ -n "$result_temporary" ]]; then
    rm -f "$result_temporary"
  fi
  if [[ -n "$lock_dir" ]]; then
    rmdir "$lock_dir" 2>/dev/null || true
  fi
  if (( status == 0 )) && [[ -n "$success_message" ]]; then
    echo "$success_message"
  fi

  exit "$status"
}

trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

[[ "$#" == 1 ]] || {
  usage
  exit 2
}

model="$1"
[[ "$model" =~ ^[A-Za-z0-9]([A-Za-z0-9._/:-]*[A-Za-z0-9])?$ ]] ||
  die "Invalid Ollama model identifier."
[[ -d "$STACK_DIR" ]] || die "Bystrek stack directory not found: $STACK_DIR"
[[ -f "$ENV_FILE" && ! -L "$ENV_FILE" ]] || die "Bystrek environment file not found: $ENV_FILE"
[[ -f "$CONFIG_FILE" ]] || die "Evaluator credentials not found. Run setup-bystrek-evaluator first."
require_owner_only "$CONFIG_DIR"
require_owner_only "$CONFIG_FILE"

eval_auth_token="$(read_eval_token)"

if ! docker exec ollama ollama show "$model" >/dev/null; then
  die "Ollama model is not available: $model"
fi

api_image="$(docker inspect --format '{{.Config.Image}}' bystrek-api-1)"
[[ "$api_image" == ghcr.io/bystrek/api:* ]] ||
  die "Bystrek API container is not using an expected GHCR image: $api_image"

install -d -m 700 "$EVALUATIONS_DIR"
lock_dir="${EVALUATIONS_DIR}/.evaluate-bystrek-model.lock"
if ! mkdir "$lock_dir" 2>/dev/null; then
  die "Another evaluation is already running, or its lock remains: $lock_dir"
fi

original_model_count=0
while IFS= read -r line || [[ -n "$line" ]]; do
  case "$line" in
    LLM_MODEL=*)
      ((original_model_count += 1))
      original_model_line="$line"
      ;;
  esac
done < "$ENV_FILE"

(( original_model_count <= 1 )) ||
  die "$ENV_FILE contains multiple LLM_MODEL entries; resolve them before evaluating."
if (( original_model_count == 1 )); then
  had_original_model=true
fi

model_changed=true
write_active_model "$model"
recreate_api

if ! wait_for_api; then
  die "API did not become available after $((API_WAIT_ATTEMPTS * API_WAIT_SECONDS)) seconds."
fi

timestamp="$(date -u +%Y%m%dT%H%M%SZ)"
safe_model="${model//\//_}"
safe_model="${safe_model//:/_}"
result_file="${EVALUATIONS_DIR}/${timestamp}-${safe_model}.json"
result_temporary="${EVALUATIONS_DIR}/.${timestamp}-${safe_model}.$$.json"

EVAL_AUTH_TOKEN="$eval_auth_token" compose exec -T \
  -e EVAL_AUTH_TOKEN \
  -e EVAL_RESET_HISTORY=true \
  api bun /app/scripts/evaluate-chat.ts > "$result_temporary"
mv -f "$result_temporary" "$result_file"
result_temporary=''
success_message="Saved evaluation: $result_file"
