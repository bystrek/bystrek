#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_DIR="${HOME}/.config/bystrek"
CONFIG_FILE="${CONFIG_DIR}/evaluator.env"

umask 077

if [[ -L "$CONFIG_DIR" ]]; then
  echo "Refusing symbolic link: $CONFIG_DIR" >&2
  exit 1
fi

if [[ -e "$CONFIG_FILE" || -L "$CONFIG_FILE" ]]; then
  echo "Refusing to replace existing evaluator credentials: $CONFIG_FILE" >&2
  echo "Remove it first to configure a new token." >&2
  exit 1
fi

install -d -m 700 "$CONFIG_DIR"

read -r -s -p "EVAL_AUTH_TOKEN: " eval_auth_token
printf '\n'

if [[ -z "$eval_auth_token" || "$eval_auth_token" == *$'\n'* || "$eval_auth_token" == *$'\r'* ]]; then
  echo "EVAL_AUTH_TOKEN must not be empty or contain a line break." >&2
  exit 1
fi

printf 'EVAL_AUTH_TOKEN=%s\n' "$eval_auth_token" > "$CONFIG_FILE"
chmod 600 "$CONFIG_FILE"
unset eval_auth_token

echo "Stored evaluator credentials in $CONFIG_FILE."
