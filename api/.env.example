PORT=3000
DATABASE_URL=postgres://bystrek:bystrek@localhost:5432/bystrek
CORS_ORIGINS=http://localhost:4200

# Auth (better-auth)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Frontend origin: sign-in hands the session back only to it (or to any
# http://localhost UI)
UI_URL=http://localhost:4200
# This API's own public origin. better-auth builds the Pocket ID callback
# (${API_URL}/api/auth/callback/pocket-id) from it, whatever way a request
# reaches the API
API_URL=http://localhost:3000

# Sign-in through Pocket ID (OIDC). Anyone the Pocket ID client allows can sign
# in, and their account is created on the first sign-in. Locally, use a second
# client (e.g. bystrek-dev) with callback
# http://localhost:3000/api/auth/callback/pocket-id and PKCE on.
OIDC_ISSUER=https://auth.bystrek.dev
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Members of this Pocket ID group get the admin role, set on every sign-in
OIDC_ADMIN_GROUP=bystrek-admins

# Model for "ask your calendar" (POST /calendar/ask): any OpenAI-compatible chat
# completions API. Production uses Scaleway Generative APIs.
LLM_BASE_URL=https://api.scaleway.ai/<project-id>/v1
LLM_MODEL=mistral-small-3.2-24b-instruct-2506
# Bearer token: a Scaleway IAM application's secret key
LLM_API_KEY=
# Optional: per-request model timeout in milliseconds
LLM_TIMEOUT_MS=15000

# Geocoder for places: any Nominatim-compatible API. Defaults to public
# Nominatim (https://operations.osmfoundation.org/policies/nominatim/): at most
# 1 request/s, which the API enforces itself, and results need OSM attribution.
GEOCODER_URL=https://nominatim.openstreetmap.org
# Identifies the app, not a person — no email addresses (rejected at startup)
GEOCODER_USER_AGENT=bystrek (+https://github.com/bystrek/bystrek)

# Tier-2 field encryption for calendar credentials.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
