PORT=3000
DATABASE_URL=postgres://bystrek:bystrek@localhost:5432/bystrek
CORS_ORIGINS=http://localhost:5173

# Generate with: bun run --cwd ../push-service generate-vapid (or reuse push-service's existing pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bobrowicz.michal@gmail.com

# Only needed to run `bun run db:seed`
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=

# Auth (better-auth)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Password-reset email delivery (Resend)
RESEND_API_KEY=
# Frontend origin — where reset-password links point
UI_URL=http://localhost:5173
# This API's own public origin — better-auth needs it to build correct
# links (e.g. the reset-password callback) regardless of how a request
# reaches it
API_URL=http://localhost:3000
