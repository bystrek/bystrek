PORT=3000
DATABASE_URL=postgres://bystrek:bystrek@localhost:5432/bystrek
CORS_ORIGINS=http://localhost:4200

# Only needed to run `bun run db:seed`
SEED_OWNER_NAME=
SEED_OWNER_EMAIL=
# Local dev only: password for the seeded owner (scripts/seed-local.ts)
SEED_OWNER_PASSWORD=

# Auth (better-auth)
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Password-reset email delivery (Resend)
RESEND_API_KEY=
# Frontend origin — where reset-password links point
UI_URL=http://localhost:4200
# This API's own public origin — better-auth needs it to build correct
# links (e.g. the reset-password callback) regardless of how a request
# reaches it
API_URL=http://localhost:3000

# Ollama for "ask your calendar" (POST /calendar/ask)
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
# Optional: Ollama `think` option ("true" or "false"); unset leaves it out.
# "false" is tested: qwen3 with thinking on is much slower for short answers.
LLM_THINK=false
# Optional: per-request Ollama timeout in milliseconds
LLM_TIMEOUT_MS=120000

# Tier-2 field encryption for calendar credentials.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
