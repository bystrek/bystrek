:3000 {
	encode gzip zstd
	root * /srv

	# Angular emits content-hashed bundles (main-<hash>.js, chunk-<hash>.js, styles-<hash>.css, media/*).
	@hashed {
		path_regexp ^/((main|chunk|styles|polyfills)-[A-Za-z0-9_-]{8}\.(js|css|mjs)|media/.+)$
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Shell and runtime config must be revalidated on every load so new deploys are picked up.
	header /index.html Cache-Control "no-cache"
	header /config.json Cache-Control "no-cache"

	# Missing assets 404 instead of falling back to index.html (stale chunk requests after a deploy).
	@asset path *.js *.mjs *.css *.map *.json *.png *.svg *.ico *.webmanifest *.txt
	handle @asset {
		file_server
	}

	handle {
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
