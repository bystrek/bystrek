{
  "name": "ui",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "prestart": "bun run ekierka:build",
    "start": "ng serve",
    "prestart:remote": "bun run ekierka:build",
    "start:remote": "ng serve --proxy-config proxy.remote.conf.json",
    "prebuild": "bun run ekierka:build",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "pretest": "bun run ekierka:build",
    "test": "ng test",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css}\" \"e2e/**/*.ts\" \"playwright.config.ts\"",
    "prestorybook": "bun run ekierka:build",
    "storybook": "ng run ui:storybook",
    "prebuild-storybook": "bun run ekierka:build",
    "build-storybook": "ng run ui:build-storybook",
    "ekierka:build": "bun run --filter '@ekierka/elements' --filter '@ekierka/lit' build"
  },
  "private": true,
  "packageManager": "bun@1.4.0",
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/forms": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@ekierka/angular": "workspace:*",
    "@ekierka/elements": "workspace:*",
    "@ekierka/lit": "workspace:*",
    "@ekierka/lit-angular": "workspace:*",
    "@js-temporal/polyfill": "^0.5.1",
    "@maplibre/ngx-maplibre-gl": "22.3.1",
    "@ngrx/signals": "22.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "dompurify": "^3.4.14",
    "es-toolkit": "^1.53.2",
    "lit": "^3.3.3",
    "maplibre-gl": "6.17.0",
    "marked": "^18.0.11",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@playwright/test": "^1.62.1",
    "@types/dompurify": "^3.2.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "vitest": "^4.0.8",
    "storybook": "^10.6.3",
    "@storybook/angular-vite": "^10.6.3",
    "@storybook/addon-a11y": "^10.6.3",
    "@types/node": "^20",
    "@angular-devkit/build-angular": "^22.1.3",
    "@angular-devkit/architect": "^0.2201.3",
    "@angular-devkit/core": "^22.1.3",
    "@angular/animations": "^22.1.3",
    "@analogjs/vite-plugin-angular": "^2.7.3"
  }
}
